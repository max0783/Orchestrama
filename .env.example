# ollama-mcp-bridge — environment variable reference
# Copy this file to .env and adjust values as needed.

# ---------------------------------------------------------------------------
# Ollama connection
# ---------------------------------------------------------------------------

# Base URL of the Ollama service.
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Default model to use when the orchestrator does not specify one.
# Default: llama3.1:8b
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Token limit used for chunking decisions (1 token ≈ 4 characters).
# Default: 4096
OLLAMA_CONTEXT_WINDOW=4096

# Keep-alive duration passed to Ollama on every /api/generate call.
# Use "0" to unload the model immediately after each request.
# Use "-1" to keep the model loaded indefinitely.
# Default: 10m
OLLAMA_KEEP_ALIVE=10m

# Number of concurrent Ollama requests (maps to p-queue concurrency).
# Default: 1
OLLAMA_NUM_PARALLEL=1

# ---------------------------------------------------------------------------
# Bridge behaviour
# ---------------------------------------------------------------------------

# Comma-separated list of absolute directory paths the bridge may read files from.
# Default: current working directory (process.cwd())
# BRIDGE_ALLOWED_DIRS=/home/user/projects,/home/user/data

# Override the built-in system prompt injected into every Ollama call.
# Default: built-in token-saving prompt
# BRIDGE_SYSTEM_PROMPT=Be concise. Return only findings.

# Capability map as a JSON string: pattern → model name.
# Patterns are matched case-insensitively as substrings of the prompt.
# Default: {} (no routing rules; falls back to OLLAMA_DEFAULT_MODEL)
# BRIDGE_CAPABILITY_MAP={"review":"codellama","log":"mistral","summarize":"llama3"}

# Comma-separated ordered list of fallback models tried on local_resource_exhausted.
# Default: (empty — no automatic retry)
# BRIDGE_FALLBACK_MODELS=llama3:8b,phi3:mini,tinyllama

# Maximum number of requests that may sit in the queue at once.
# Requests arriving when the queue is full are rejected with queue_full.
# Default: 10
BRIDGE_QUEUE_MAX_SIZE=10

# Per-request timeout in milliseconds.
# Default: 300000 (5 minutes)
BRIDGE_REQUEST_TIMEOUT_MS=300000

# Maximum number of context_files entries accepted per query_local_model call.
# Default: 20
BRIDGE_MAX_CONTEXT_FILES=20

# Maximum estimated tokens per individual context file.
# Default: 1024
BRIDGE_MAX_FILE_TOKENS=1024

# Maximum combined estimated tokens across all context files in one request.
# Default: 4096
BRIDGE_MAX_TOTAL_CONTEXT_TOKENS=4096

# Path to the append-only JSONL reduction log file.
# Default: ./ollama-bridge-reductions.jsonl
BRIDGE_REDUCTION_LOG=./ollama-bridge-reductions.jsonl

# Log verbosity. "debug" includes full payload content in logs and reduction records.
# Default: info
BRIDGE_LOG_LEVEL=info

# Set to "true" to suppress all MCP progress notifications.
# Default: false
BRIDGE_DISABLE_PROGRESS=false

# Set to "true" to send a keep-alive ping to the default model at startup,
# pre-loading it into Ollama memory before accepting any client requests.
# Default: false
BRIDGE_KEEPALIVE_ON_START=false

# ---------------------------------------------------------------------------
# Benchmark
# ---------------------------------------------------------------------------

# If set, the benchmark_models tool saves its full JSON results to this file.
# Default: (not set — results are only returned as text to the orchestrator)
# BENCHMARK_OUTPUT_FILE=./benchmark-results.json

# ---------------------------------------------------------------------------
# Model fine-tuning
# ---------------------------------------------------------------------------

# JSON object of Ollama generation options applied to every request.
# These are global defaults; individual query_local_model calls can override
# them per-call using the `options` parameter.
#
# Supported fields:
#   temperature     — sampling temperature (0.0–2.0). Lower = more deterministic.
#   top_p           — nucleus sampling (0.0–1.0)
#   top_k           — top-k sampling (integer, 0 = disabled)
#   repeat_penalty  — penalty for repeated tokens (1.0 = no penalty)
#   seed            — fixed random seed (-1 = random)
#   num_predict     — max tokens to generate (-1 = model default)
#   min_p           — minimum token probability (0.0–1.0)
#   tfs_z           — tail-free sampling parameter
#
# Default: (not set — all values use the model's built-in defaults)
# OLLAMA_MODEL_OPTIONS={"temperature":0.2,"seed":42}
